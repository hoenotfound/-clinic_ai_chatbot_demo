# Server
PORT=3000
NODE_ENV=development

# AI provider: gemini | claude | mock
AI_PROVIDER=gemini

# Gemini failover order:
# key 1 -> retry -> key 2 -> retry -> fallback model -> deterministic mock
# The whole Gemini chain shares one time budget; once exhausted, the demo falls back immediately.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_RETRY_DELAY_MS=250
GEMINI_FAILOVER_BUDGET_MS=12000
# Legacy single-key compatibility. Used only when KEY_1 and KEY_2 are both empty.
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_MS=15000

# Optional shared state (recommended for public deployment)
REDIS_URL=

# Private live demo operations dashboard at /ops
# Both values must be set or the page remains disabled.
DEMO_OPS_USERNAME=
DEMO_OPS_PASSWORD=
DEMO_STATS_TIMEZONE=Asia/Kuala_Lumpur
# Responses at or above this end-to-end duration are counted as slow.
DEMO_SLOW_RESPONSE_MS=4000

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Public demo limits
DEMO_SESSION_MINUTES=60
DEMO_MAX_MESSAGES=30
DEMO_MAX_SESSIONS_PER_IP_DAY=20
DEMO_MAX_TOTAL_MESSAGES_PER_DAY=500
DEMO_MAX_MESSAGES_PER_IP_MINUTE=10
DEMO_MAX_MESSAGES_PER_IP_DAY=60
# Telemetry is lightweight; this high ceiling only blocks abusive floods.
DEMO_MAX_TELEMETRY_PER_IP_MINUTE=120
DEMO_AI_HISTORY_MAX_MESSAGES=16
DEMO_AI_HISTORY_MAX_CHARS=12000
DEMO_MIN_MESSAGE_INTERVAL_MS=900
DEMO_MAX_TOTAL_MESSAGES_PER_SESSION=60
DEMO_MAX_STAFF_MESSAGES_PER_SESSION=20
DEMO_MIN_STAFF_MESSAGE_INTERVAL_MS=700
DEMO_MAX_CONCURRENT_AI_REQUESTS=8

# Sales call-to-action shown after the demo
SALES_CTA_LABEL=Set up my clinic
SALES_CTA_URL=
